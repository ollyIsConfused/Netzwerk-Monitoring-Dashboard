# nginx-Site fuer das Dashboard auf dem Webserver (wird von install.sh befuellt).
# Liefert das gebaute Frontend aus und leitet /api und /ws an das Backend weiter,
# das selbst nur auf 127.0.0.1:8000 lauscht. Nach aussen ist damit nur dieser
# eine Port sichtbar - fuer Browser (per VPN) und den Collector auf dem Router-Pi.
# Bewusst nur IPv4: im Heimnetz laeuft alles ueber IPv4, und ohne IPv6-Listener ist
# das Dashboard nicht ueber eventuell durchgereichte globale IPv6-Adressen erreichbar.
server {
    listen __PORT__;
    server_name _;

    root __ROOT__/frontend/dist;
    index index.html;

    # Sicherheits-Header fuer alle Antworten (auch Fehlerseiten: "always").
    # CSP: Skripte, Styles, Bilder und Verbindungen (API, WebSocket) nur von dieser Adresse;
    # 'unsafe-inline' bei style-src fuer die Inline-Styles der Diagramme.
    # HSTS wirkt nur ueber HTTPS (z. B. ueber Cloudflare/Caddy), per HTTP ignoriert der Browser es.
    server_tokens off;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # React-Router: unbekannte Pfade liefern die App aus
    location / {
        try_files $uri /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /ws/ {
        proxy_pass http://127.0.0.1:8000/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 1h;
    }
}
