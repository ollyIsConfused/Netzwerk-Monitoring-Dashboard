# Werte mit Leerzeichen oder Sonderzeichen in einfache Anfuehrungszeichen setzen: KEY='wert'
# deploy/webserver/install.sh (Server) bzw. ./dev.sh (lokal) legen diese Datei beim
# ersten Start selbst an und fuellen Zufallswerte ein.

# Datenbank
# Fuer die lokale Docker-Compose-Variante reichen die drei Werte unten (docker-compose.yml
# und dev.sh bauen daraus automatisch die Verbindung zum "db"-Container).
# Fuer ein natives Deployment (z.B. Postgres auf einer separaten NAS, siehe docs/deployment.md)
# zusaetzlich DATABASE_URL direkt setzen (Sonderzeichen im Passwort URL-kodiert), z.B.:
# DATABASE_URL=postgresql+psycopg2://monitoring:change-me@<nas-ip>:5432/monitoring
POSTGRES_DB=monitoring
POSTGRES_USER=monitoring
POSTGRES_PASSWORD=change-me

# Backend
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480

# Login-Bremse: nach so vielen Fehlversuchen von einer Adresse ist die Anmeldung so viele
# Sekunden gesperrt (pro Benutzername gilt das Doppelte an Fehlversuchen)
LOGIN_MAX_FAILURES=5
LOGIN_BLOCK_SECONDS=300
# API-Beschreibung unter /docs - im Betrieb aus lassen, zum Entwickeln 1
ENABLE_API_DOCS=0
# Nur wenn das Frontend von einer anderen Adresse kommt als die API, z. B.
# CORS_ORIGINS=https://dashboard.example.com (leer = Frontend und API ueber denselben nginx)
CORS_ORIGINS=

# Shared secret between Backend und Collector (Collector authentifiziert sich damit
# statt mit einem Benutzer-Login, da er das ganze Netzwerk pollt, nicht fuer einen User)
COLLECTOR_API_TOKEN=change-me-to-a-long-random-string

# Collector
# BACKEND_URL: bei getrenntem Deployment (z.B. Collector auf dem Router-Pi) die
# oeffentliche/erreichbare HTTPS-Adresse des Backends eintragen, z.B. https://dashboard.example.com
BACKEND_URL=http://backend:8000
POLL_INTERVAL_SECONDS=30
# Kommt so lange (Sekunden) kein neuer Messwert vom Collector bzw. Agenten, zeigt das
# Dashboard "Veraltet" und einen Hinweis. Deutlich groesser als eine Abfragerunde waehlen.
STALE_AFTER_SECONDS=180

# E-Mail (Alarme und Passwort-Mails). Gmail: smtp.gmail.com, Port 587, als Passwort ein
# App-Passwort (Google-Konto > Sicherheit > App-Passwoerter), nicht das Konto-Passwort.
# Port 465 = SSL, sonst STARTTLS. Testen: python -m app.mailtest (siehe README)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Absender (leer = SMTP_USER)
ALERT_EMAIL_FROM=
# Empfaenger der Alarm-Mails (mehrere mit Komma)
ALERT_EMAIL_TO=
# Empfaenger der "Passwort vergessen"-Anfragen (mehrere mit Komma); leer = alle aktiven Admins
ADMIN_NOTIFY_EMAIL=
# Adresse des Dashboards fuer Links in den Mails, z.B. http://192.168.30.15:8080 (install.sh setzt sie)
DASHBOARD_URL=

# Erster Admin-Benutzer "admin" (nur beim allerersten Start, app/seed.py).
# Leeres Passwort = Startpasswort "admin". Beim ersten Anmelden muss so oder so ein
# eigenes Passwort festgelegt werden.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
# Beispiel-VLANs (10/20/30) anlegen, wenn noch keine VLANs existieren (0 = nein)
SEED_EXAMPLE_VLANS=1
