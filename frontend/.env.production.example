# Nur nötig, wenn Frontend und Backend NICHT hinter demselben Reverse-Proxy-Pfad
# laufen (z.B. Frontend via pm2/serve auf einem Port, Backend auf einem anderen).
# Vor "npm run build" nach .env.production kopieren und anpassen, oder als
# Umgebungsvariablen beim Build setzen.

VITE_API_BASE_URL=https://dashboard.example.com/api
VITE_WS_BASE_URL=wss://dashboard.example.com/ws
